<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/activatedBackgroundIndicator"
    android:descendantFocusability="blocksDescendants"
    android:padding="12dp"
    android:paddingStart="8dp">

    <ImageView
        android:id="@+id/image_view_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_script"
        android:scaleType="center"
        android:contentDescription="@string/title_script" />

    <TextView
        android:id="@+id/text_view_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/image_view_icon"
        app:layout_constraintEnd_toStartOf="@id/switch_script_is_active"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_1"
        tools:text="@tools:sample/backgrounds/scenic"
        android:textSize="@dimen/font_default" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_script_is_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/image_view_menu"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="6dp"
        app:trackTint="@drawable/switch_track_selector"
        app:thumbTint="@drawable/switch_thumb_selector"
        tools:checked="true"
        tools:enabled="true"/>

    <ImageView
        android:id="@+id/image_view_menu"
        android:layout_width="36dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_dots"
        android:scaleType="center"
        android:contentDescription="@string/title_context_menu" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image_view_icon, text_view_file_name, switch_script_is_active, image_view_menu"/>

    <TextView
        android:id="@+id/text_view_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/text_view_file_name"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_2"
        tools:text="@tools:sample/backgrounds/scenic"
        android:textSize="@dimen/font_small" />

    <ImageView
        android:id="@+id/image_view_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_view_description"
        app:layout_constraintEnd_toStartOf="@id/text_view_error"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_warning_red_2"
        android:scaleType="center"
        android:contentDescription="@string/title_storage_error" />

    <TextView
        android:id="@+id/text_view_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/image_view_error"
        app:layout_constraintTop_toTopOf="@id/image_view_error"
        app:layout_constraintEnd_toStartOf="@id/image_view_menu"
        android:paddingTop="2dp"
        android:layout_marginStart="8dp"
        android:textColor="@color/error_1"
        tools:text="@tools:sample/lorem"
        android:textSize="@dimen/font_small" />

</androidx.constraintlayout.widget.ConstraintLayout>