<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/activatedBackgroundIndicator"
    android:descendantFocusability="blocksDescendants"
    android:paddingVertical="6dp"
    android:paddingHorizontal="12dp"
    android:paddingStart="36dp">

    <ImageView
        android:id="@+id/image_view_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_script"
        android:scaleType="center"
        android:contentDescription="@string/title_script" />

    <TextView
        android:id="@+id/text_view_object_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/image_view_icon"
        app:layout_constraintEnd_toStartOf="@id/switch_script_is_active"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_2"
        tools:text="Включено для записи «Тестовая запись с длинным названием»"
        android:textSize="@dimen/font_small_small" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_script_is_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:trackTint="@drawable/switch_track_selector"
        app:thumbTint="@drawable/switch_thumb_selector"
        tools:checked="true"
        tools:enabled="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>